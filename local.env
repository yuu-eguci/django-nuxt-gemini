# この .env は開発環境用のものです。
# デプロイするときは本番用の .env で上書きしてくださいね!
PIPENV_VENV_IN_PROJECT=1
MYSQL_DATABASE=app
MYSQL_USER=LocalAdmin
MYSQL_PASSWORD=LocalAdminPassword
MYSQL_ROOT_PASSWORD=LocalRootPassword
DJANGO_SECRET_KEY=django-insecure-xxxxxxxxxxxx
# config.settings_staging (gunicorn) の ALLOWED_HOSTS です。カンマ区切りで指定します。
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
MYSQL_HOSTNAME=gemini-mysql-container
MYSQL_PORT=3306
# Nuxt.js から呼び出す API の URL です。 (nuxt.config.js の axios.baseURL になります。)
API_URL=http://localhost:8001/
